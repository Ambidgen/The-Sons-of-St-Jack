  "spring_intro": [
   {
    "card": "Harrowgate",
    "sub": "The spring Derrick was five.",
    "hold": 2.4
   },
   {
    "sound": "Larks. A plough horse blowing, somewhere past the hedges."
   },
   {
    "caption": "Harrowgate was the whole world, then. It had a church with one bell, a green, and a well deeper than God."
   },
   {
    "camera": [
     16,
     5
    ],
    "time": 2.0
