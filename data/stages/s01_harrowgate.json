  "spring_walk": [
   {
    "face": "mother",
    "to": "player"
   },
   {
    "talk": [
     [
      "mother",
      "Stay on the road, Derrick. The furrows are your father's, not yours."
     ],
     [
      "derrick",
      "I know."
     ],
     [
      "mother",
      "You know. And yesterday?"
     ],
     [
      "derrick",
      "...Yesterday I didn't know."
     ]
    ]
   },
   {
    "act": "mother",
    "do": "nod"
   },
   {
