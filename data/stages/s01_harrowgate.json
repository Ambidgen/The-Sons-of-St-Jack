    "face": "father",
    "to": "player"
   },
   {
    "talk": [
     [
      "father",
      "Here he is. Come to take the plough off me?"
     ],
     [
      "derrick",
      "I can do it."
     ],
     [
      "father",
      "Course you can. Hands here. Lean on it. Now push."
     ]
    ]
   },
   {
    "act": "player",
    "do": "attack",
    "wait": true
   },
   {
    "caption": "The plough did not move. His father pushed it for him, and told everyone at supper that Derrick had ploughed a furrow."
   },
   {
    "walk": "mother",
    "to": [
     11,
     6
    ],
    "speed": 3
   },
   {
    "talk": [
