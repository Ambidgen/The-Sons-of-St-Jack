 "scripts": {
  "intro": [
   {
    "card": "Wendmere Field",
    "sub": "Four years on. The night before.",
    "hold": 2.6
   },
   {
    "growth": true
   },
   {
    "sound": "Two hundred men pretending to sleep. A whetstone, somewhere, that never stops."
   }
  ],
  "spear": [
   {
    "face": "sergeant",
    "to": "player"
   },
   {
    "talk": [
     [
      "sergeant",
      "Name?"
     ],
     [
      "derrick",
      "Derrick."
     ],
     [
      "sergeant",
      "From?"
     ],
     [
      "derrick",
      "...Nowhere."
     ],
     [
      "sergeant",
      "Good. Nowhere's got no lord to whinge to. Harl's company. Front rank."
     ],
     [
      "sergeant",
      "That's a spear. The pointy end goes toward the other lot. Any questions?"
     ],
     [
      "derrick",
      "Which lot is the other lot?"
     ],
     [
      "sergeant",
      "The ones that aren't us. Next!"
     ]
    ]
   }
  ],
  "fire": [
   {
    "talk": [
     [
      "soldier3",
      "...I'm telling you. Gauntley. He's riding with the lord's van."
     ],
     [
      "soldier1",
      "The Gauntley? Out of the songs?"
     ],
     [
      "soldier3",
      "Saw his horse myself. Big grey thing, eats like a bishop."
     ]
    ]
   },
   {
    "act": "player",
    "do": "cower"
   },
   {
    "wait": 0.6
   },
   {
    "act": "player",
    "do": "reset"
   },
   {
    "caption": "He could have walked thirty yards and seen him. He did not go to look."
   }
  ],
  "aldo": [
   {
    "face": "aldo",
    "to": "player"
   },
   {
    "talk": [
     [
      "aldo",
      "You. Harrowgate, isn't it? I heard you tell Pike nowhere. That's a lie, but it's a good one."
     ],
     [
      "aldo",
      "Aldo. Wendmere born. Sit, sit, the fire's not mine."
     ],
     [
      "aldo",
      "Two daughters. Bess, and little Aldo, who hates it. And a miller who'll have my roof if I don't come home with the purse."
     ],
     [
      "derrick",
      "Then come home with the purse."
     ],
     [
      "aldo",
      "Ha! That's the plan. Stick by me tomorrow, Harrowgate. Two's harder to kill than one."
     ],
     [
      "derrick",
      "...All right."
     ]
    ]
   },
   {
    "caption": "He had not said all right to anyone in seven years. It came out strange."
   }
  ],
  "horns": [
   {
    "sound": "Horns, before light. Somebody being sick behind a wagon."
   },
   {
    "caption": "The battle at Wendmere lasted until a little after noon."
   }
  ]
 }
